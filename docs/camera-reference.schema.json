{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Portal Lab camera intrinsic reference v1",
  "type": "object",
  "required": ["fx", "fy", "cx", "cy", "width", "height", "distortion", "orientation", "source", "provenance", "uncertainty"],
  "properties": {
    "fx": {"type":"number","exclusiveMinimum":0},
    "fy": {"type":"number","exclusiveMinimum":0},
    "cx": {"type":"number"},
    "cy": {"type":"number"},
    "width": {"type":"integer","minimum":1},
    "height": {"type":"integer","minimum":1},
    "distortion": {"type":"array","items":{"type":"number"},"minItems":0,"maxItems":5},
    "orientation": {"enum":["portrait","landscape"]},
    "source": {"const":"reference"},
    "provenance": {"type":"string","minLength":1},
    "uncertainty": {"type":"string","minLength":1},
    "configuration": {"type":"object"}
  },
  "$comment": "Runtime additionally restricts coefficient count to 0, 4 or 5 and enforces exact delivered stream compatibility. Source is an explicit researcher declaration, not independent certification."
}
