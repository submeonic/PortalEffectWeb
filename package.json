{
  "name": "portal-effect-research",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "assets": "node scripts/fetch-assets.mjs",
    "simulate": "node --import tsx scripts/simulate.ts",
    "evaluate": "node --import tsx scripts/evaluate.ts",
    "format": "prettier --write src tests scripts/*.ts *.ts *.json"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.32",
    "three": "0.180.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@types/node": "^24.0.0",
    "@types/three": "^0.180.0",
    "prettier": "^3.9.10",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.12",
    "vitest": "^5.0.5"
  }
}
